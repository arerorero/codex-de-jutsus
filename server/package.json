{
  "name": "codex-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:setup": "prisma db push --skip-generate && prisma generate && node prisma/seed.js",
    "db:reset": "prisma db push --force-reset --skip-generate && node prisma/seed.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
